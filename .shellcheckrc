# Resolve sourced files relative to the script being checked.
# Lets shellcheck follow `source "$(dirname "$0")/../lib/ora-common.sh"`
# in bin/*.sh and catch undefined helpers from the lib.
source-path=SCRIPTDIR
external-sources=true

# Pin the dialect explicitly so any file without a shebang is still treated as bash.
shell=bash

# Don't flag dynamic `source "$ENV_FILE"` calls (env files live outside the repo).
# SC1090 = non-constant source path; SC1091 = file not found at lint time.
# SC2029 = vars in ssh remote-command expand client-side. In ora-migrate-cloud.sh
# we build paths (REMOTE_PATH, REMOTE_SCRIPT) locally then ssh to use them remotely
# — local expansion is the whole point.
disable=SC1090,SC1091,SC2029

# Opt-in checks worth turning on:
enable=quote-safe-variables       # warns when an unquoted var could word-split
enable=add-default-case           # forces a default branch in case statements
enable=check-unassigned-uppercase # catches typos like $CONNNECT_STRING
enable=require-variable-braces    # consistent ${var}, matches your existing style
